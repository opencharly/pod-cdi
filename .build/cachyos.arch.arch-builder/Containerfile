# Layer: github.com/opencharly/layer-pixi
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
ENV PIXI_VERSION="v0.70.2"
RUN --mount=type=cache,id=charly-var-cache-charly-downloads,dst=/var/cache/charly/downloads,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH" -c "$1"' sh 'export BUILD_ARCH=$(uname -m); mkdir -p /var/cache/charly/downloads; __u="https://github.com/prefix-dev/pixi/releases/download/${PIXI_VERSION}/pixi-${BUILD_ARCH}-unknown-linux-musl.tar.gz"; __c=/var/cache/charly/downloads/$(printf %s "$__u" | sha256sum | cut -c1-64); [ -s "$__c" ] || { curl -fsSL "$__u" -o "$__c.part" && mv -f "$__c.part" "$__c"; } && mkdir -p /usr/local/bin && tar -xzf "$__c" -C /usr/local/bin '
RUN mkdir -p '/etc/profile.d' && cat > '/etc/profile.d/charly-pixi-bash.sh' <<'CHARLY_SHELL_BASH_1b261e29'
# opencharly: guard — this drop-in is for bash only (every /etc/profile.d/*.sh is sourced by every POSIX login shell)
if [ -n "${BASH_VERSION:-}" ] && [ -z "${ZSH_VERSION:-}" ]; then
	export PATH="$PATH:/home/user/.pixi/bin"
fi

CHARLY_SHELL_BASH_1b261e29
RUN mkdir -p '/etc/profile.d' && cat > '/etc/profile.d/charly-pixi-zsh.sh' <<'CHARLY_SHELL_ZSH_d4507eb0'
# opencharly: guard — this drop-in is for zsh only (every /etc/profile.d/*.sh is sourced by every POSIX login shell)
if [ -n "${ZSH_VERSION:-}" ]; then
	export PATH="$PATH:/home/user/.pixi/bin"
fi

CHARLY_SHELL_ZSH_d4507eb0
RUN mkdir -p '/etc/fish/conf.d' && cat > '/etc/fish/conf.d/charly-pixi.fish' <<'CHARLY_SHELL_FISH_f3370450'
fish_add_path -gP '/home/user/.pixi/bin'

CHARLY_SHELL_FISH_f3370450
RUN mkdir -p '/etc/profile.d' && cat > '/etc/profile.d/charly-pixi-sh.sh' <<'CHARLY_SHELL_SH_01ca8e72'
# opencharly: guard — this drop-in is for sh only (every /etc/profile.d/*.sh is sourced by every POSIX login shell)
if [ -z "${BASH_VERSION:-}" ] && [ -z "${ZSH_VERSION:-}" ]; then
	export PATH="$PATH:/home/user/.pixi/bin"
fi

CHARLY_SHELL_SH_01ca8e72

# Layer: github.com/opencharly/layer-nodejs
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
ENV PNPM_VERSION="10.33.4"
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
pacman-key --init && \
(pacman-key --populate 2>/dev/null || true) && \
pacman -Syu --noconfirm --needed nodejs npm
RUN --mount=type=bind,from=nodejs,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
case "${BUILD_ARCH}" in
  x86_64)  PNPM_ARCH="x64" ;;
  aarch64) PNPM_ARCH="arm64" ;;
  *) echo "Unsupported arch: ${BUILD_ARCH}"; exit 1 ;;
esac
curl -fsSL "https://github.com/pnpm/pnpm/releases/download/v${PNPM_VERSION}/pnpm-linux-${PNPM_ARCH}" -o /usr/local/bin/pnpm
chmod 0755 /usr/local/bin/pnpm
OVCMD

# Layer: github.com/opencharly/layer-build-toolchain
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
pacman-key --init && \
(pacman-key --populate 2>/dev/null || true) && \
pacman -Syu --noconfirm --needed autoconf automake binutils bison ccache cmake flex gdb git libtool nasm patch clang ffmpeg gcc glibc libdrm libinput libjpeg-turbo seatd libva libxkbcommon make mesa ninja opusfile pixman pkgconf portaudio rust systemd wayland x264

# Layer: github.com/opencharly/layer-yay
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
pacman-key --init && \
(pacman-key --populate 2>/dev/null || true) && \
pacman -Syu --noconfirm --needed base-devel git
RUN --mount=type=bind,from=yay,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
URL=$(curl -fsSL https://api.github.com/repos/Jguer/yay/releases/latest \
  | grep -o "https://github.com/Jguer/yay/releases/download/[^\"]*_${BUILD_ARCH}.tar.gz")
curl -fsSL "$URL" | tar -xzf - -C /usr/local/bin --strip-components=1 --wildcards '*/yay'
OVCMD

