direnv hook fish | source

CHARLY_SHELL_FISH_70a9bd2a

# Layer: github.com/opencharly/layer-nvidia
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
pacman-key --init && \
(pacman-key --populate 2>/dev/null || true) && \
pacman -Syu --noconfirm --needed nvidia-container-toolkit nvidia-utils
RUN mkdir -p /etc/vulkan/icd.d
RUN --mount=type=bind,from=nvidia,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
# BOTH filenames: Arch/CachyOS ship /usr/share/vulkan/icd.d/nvidia_icd.json,
# Fedora's package ships nvidia_icd.x86_64.json. Testing only the Fedora
# name made this step a silent no-op on Arch -- measured on a cachyos image:
# `ls /usr/share/vulkan/icd.d/` -> nvidia_icd.json, and /etc/vulkan/icd.d/
# carried no image-side link.
icd=
for c in /usr/share/vulkan/icd.d/nvidia_icd.json /usr/share/vulkan/icd.d/nvidia_icd.x86_64.json; do
  if [ -f "$c" ]; then icd="$c"; break; fi
done
if [ -n "$icd" ]; then
  ln -sf "$icd" /etc/vulkan/icd.d/nvidia_icd.json
  echo "wired Vulkan ICD: $icd"
else
  echo "no Vulkan ICD JSON in the package set for this distro"
fi
[ -f /usr/share/vulkan/implicit_layer.d/nvidia_layers.json ] && \
  ln -sf /usr/share/vulkan/implicit_layer.d/nvidia_layers.json /etc/vulkan/icd.d/nvidia_layers.json || true
true
OVCMD
RUN --mount=type=bind,from=nvidia,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
# Patterns == the libs the NVIDIA CDI spec injects (its own /usr/lib
# containerPaths): everything matching is host-coupled by definition.
# A symlinked /usr/lib64 (Arch) is skipped so nothing is counted or
# deleted twice.
removed=0
for d in /usr/lib /usr/lib64; do
  if [ ! -d "$d" ] || [ -L "$d" ]; then continue; fi
  out=$(find "$d" -maxdepth 1 \( -name 'libnvidia-*.so*' -o -name 'libcuda*.so*' \
        -o -name 'libnvcuvid.so*' -o -name 'libnvoptix.so*' -o -name 'libGLX_nvidia.so*' \
        -o -name 'libEGL_nvidia.so*' -o -name 'libGLESv1_CM_nvidia.so*' \
        -o -name 'libGLESv2_nvidia.so*' \) -print -delete 2>/dev/null || true)
  n=$(printf '%s\n' "$out" | grep -c . || true)
  removed=$((removed + n))
done
rm -rf /usr/lib/nvidia /usr/lib/vdpau /usr/lib/xorg/modules/drivers/nvidia_drv.so
echo "dropped $removed driver library file(s) plus the xorg/vdpau driver trees"
# THE ENFORCEMENT, and it lives HERE rather than in a `check:` step on
# purpose. This RUN executes in the build container, where no CDI has
# injected anything -- so every match below IS image content, with no
# ambiguity. A `check:` step runs in a container the GPU seam may attach,
# where the host's identical-version libs sit at the same paths, and the
# only way to tell them apart from baked ones is /proc/self/mountinfo --
# which is not readable on every venue (measured: the probe went red on a
# CORRECT fedora image for exactly that reason). A control that has to
# guess is worse than a control that cannot be fooled.
# \-type f OR \-type l: the failure this replaced was a SYMLINK
# (libnvidia-ml.so.1 -> libnvidia-ml.so.620.70.06), so a files-only count
# would let the exact bug class walk back in. The delete above has no
# -type restriction, so the two sets match.
left=$(find /usr/lib /usr/lib64 -maxdepth 1 \( -type f -o -type l \) \
    \( -name 'libnvidia-*.so*' -o -name 'libcuda*.so*' -o -name 'libnvcuvid.so*' \
    -o -name 'libnvoptix.so*' -o -name 'libGLX_nvidia.so*' -o -name 'libEGL_nvidia.so*' \
    -o -name 'libGLESv1_CM_nvidia.so*' -o -name 'libGLESv2_nvidia.so*' \) 2>/dev/null | wc -l)
echo "driver library files still baked after the strip: $left"
if [ "$left" -ne 0 ]; then
  find /usr/lib /usr/lib64 -maxdepth 1 -type f -name 'libnvidia-*.so*' 2>/dev/null | head -5
  echo "a LATER layer re-introduced a host-coupled driver library; strip it in that candy's own plan too"
  exit 1
fi
OVCMD

# Layer: github.com/opencharly/layer-cuda
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
pacman-key --init && \
(pacman-key --populate 2>/dev/null || true) && \
pacman -Syu --noconfirm --needed cuda cudnn python-onnxruntime-cpu
RUN --mount=type=bind,from=cuda,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
if [ ! -f /etc/fedora-release ]; then
  exit 0
fi
CUDNN_DIR=$(mktemp -d)
cd "$CUDNN_DIR"
if dnf5 download --enable-repo="fedora-multimedia" cuda-cudnn-devel 2>/dev/null; then
  rpm2cpio cuda-cudnn-devel*.rpm | cpio -idm 2>/dev/null
  [ -d ./usr/include ] && cp -v ./usr/include/cudnn*.h /usr/include/
  while IFS= read -r -d '' link; do
    name=$(basename "$link")
    versioned=""
    for v in /usr/lib64/"${name}".*; do
      if [ -f "$v" ] && ! echo "$v" | grep -q '\.so$'; then
        versioned="$v"; break
      fi
    done
    [ -n "$versioned" ] && [ ! -e /usr/lib64/"$name" ] && ln -sv "$(basename "$versioned")" /usr/lib64/"$name"
  done < <(find ./usr/lib64 -maxdepth 1 -name '*.so' -type l -print0 2>/dev/null)
fi
cd / && rm -rf "$CUDNN_DIR"
OVCMD
RUN --mount=type=bind,from=cuda,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
if [ ! -f /etc/arch-release ]; then
  exit 0
fi
# nvcc + cuobjdump + ptxas + nvprof — every binary in /opt/cuda/bin
for bin in /opt/cuda/bin/*; do
  [ -e "$bin" ] && ln -sf "$bin" /usr/bin/$(basename "$bin")
done
# Headers — cudnn*.h live in /opt/cuda/targets/x86_64-linux/include
# on the cudnn package, while CUDA's own headers live in
# /opt/cuda/include. Symlink both into /usr/include.
# Headers — link EVERY ENTRY of each toolkit include root, not a guessed subset.
# nvcc computes its default include root RELATIVE to its own executable, and
# /usr/bin/nvcc is a symlink, so all CUDA headers must be reachable under
# /usr/include. Enumerating by pattern is what broke this: a `*.h` glob linked the
# top-level headers but silently dropped (a) the SUBTREES crt/ and cccl/, which
# killed every build at CMake's enable_language(CUDA) with "crt/host_config.h: No
# such file or directory", and then (b) the `.hpp` half of the `_functions` family
# (`vector_functions.hpp` and friends), which killed the very next stage -- both
# reported on opencharly/layer-cuda#9. Linking every entry needs no extension list
# to keep in sync and cannot silently miss a file or a subtree again.
# nvcc resolves its OWN helpers relative to its own executable path. Through the
# /usr/bin/nvcc symlink that means /usr/<sibling>/ — so the toolkit's sibling TREES
# must exist at /usr too, not only its files. Without /usr/nvvm, nvcc cannot find its
# backend compiler at all: "$CICC_PATH/cicc: No such file or directory"
# (/usr/sbin/../nvvm/bin/cicc), and every CUDA compile dies while PREPROCESSING
# still succeeds — which is exactly how the check added in #10 stayed green through
# it. Both halves of that lesson are fixed here.
for tree in nvvm; do
  [ -d "/opt/cuda/$tree" ] && [ ! -e "/usr/$tree" ] && ln -sfn "/opt/cuda/$tree" "/usr/$tree"
done
for root in /opt/cuda/include /opt/cuda/targets/x86_64-linux/include; do
  [ -d "$root" ] || continue
  for entry in "$root"/*; do
    [ -e "$entry" ] || continue
    ln -sfn "$entry" /usr/include/"$(basename "$entry")"
  done
done
# Libraries: libcudart, libcudnn, libcurand, etc.
mkdir -p /usr/lib64
# Enumerate EVERY entry, not a `*.so*` glob. nvcc links the STATIC archives by
# default (libcudart_static.a, libcudadevrt.a, libculibos.a, ...), and a `.so*`
# pattern cannot match a `.a` — so the linker failed with "cannot find
# -lcudart_static: No such file or directory" although the package ships the file
# (opencharly/layer-cuda#12). Same defect shape as the `*.h` header glob that missed
# `.hpp`: pattern-matching a directory instead of enumerating it.
mkdir -p /usr/lib64
for libdir in /opt/cuda/targets/x86_64-linux/lib /opt/cuda/lib64; do
  [ -d "$libdir" ] || continue
  for entry in "$libdir"/*; do
    [ -e "$entry" ] || continue
    ln -sfn "$entry" /usr/lib64/"$(basename "$entry")"
  done
done
OVCMD
RUN --mount=type=bind,from=cuda,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
removed=0
for d in /usr/lib /usr/lib64; do
  if [ ! -d "$d" ] || [ -L "$d" ]; then continue; fi
  out=$(find "$d" -maxdepth 1 \( -name 'libnvidia-*.so*' -o -name 'libcuda*.so*' \
        -o -name 'libnvcuvid.so*' -o -name 'libnvoptix.so*' -o -name 'libGLX_nvidia.so*' \
        -o -name 'libEGL_nvidia.so*' -o -name 'libGLESv1_CM_nvidia.so*' \
        -o -name 'libGLESv2_nvidia.so*' \) -print -delete 2>/dev/null || true)
  n=$(printf '%s\n' "$out" | grep -c . || true)
  removed=$((removed + n))
done
rm -rf /usr/lib/nvidia /usr/lib/vdpau /usr/lib/xorg/modules/drivers/nvidia_drv.so
echo "dropped $removed driver library file(s) plus the xorg/vdpau driver trees"
# The BINARIES are host-coupled in exactly the same way, and the CDI injection
# mounts them too (measured in a live pod: nvidia-smi, nvidia-cuda-mps-control,
# nvidia-cuda-mps-server, nvidia-debugdump, nvidia-persistenced, nvidia-xconfig
# are all bind-mounted from the host). A baked copy is a second, wrong-version
# one, and for nvidia-smi it is actively misleading: it reports on the image's
# own libraries instead of the ones injected with the running driver.
#
# This deletes the WHOLE `nvidia*` set rather than a hand-listed subset. A
# subset is how this step first shipped and its own assertion caught three
# leftovers it had missed (nvidia-container-toolkit and its two
# nvidia-container-runtime.<variant> wrappers) -- because the package also
# ships nvidia-ngx-updater, nvidia-pcc, nvidia-powerd and nvidia-sleep.sh, and
# a list that has to be right about every one of them will be wrong again.
# None of them belong in an image: the NVIDIA CONTAINER TOOLKIT is HOST
# tooling -- it generates the CDI spec and lives on the operator's machine --
# so an image copy is a second, drifting one that nothing runs.
binned=0
for d in /usr/bin /usr/local/bin /usr/sbin; do
  if [ ! -d "$d" ]; then continue; fi
  out=$(find "$d" -maxdepth 1 \( -type f -o -type l \) -name 'nvidia*' \
        -print -delete 2>/dev/null || true)
  n=$(printf '%s\n' "$out" | grep -c . || true)
  binned=$((binned + n))
done
echo "dropped $binned host-coupled nvidia binary/binaries"
left=$(find /usr/lib /usr/lib64 -maxdepth 1 \( -type f -o -type l \) \
    \( -name 'libnvidia-*.so*' -o -name 'libcuda*.so*' -o -name 'libnvcuvid.so*' \
    -o -name 'libnvoptix.so*' -o -name 'libGLX_nvidia.so*' \
    -o -name 'libEGL_nvidia.so*' -o -name 'libGLESv1_CM_nvidia.so*' \
    -o -name 'libGLESv2_nvidia.so*' \) 2>/dev/null | wc -l)
bleft=0
for d in /usr/bin /usr/local/bin /usr/sbin; do
  if [ ! -d "$d" ]; then continue; fi
  n=$(find "$d" -maxdepth 1 \( -type f -o -type l \) -name 'nvidia*' 2>/dev/null | wc -l)
  bleft=$((bleft + n))
done
echo "driver library files still baked after the strip: $left"
echo "host-coupled nvidia binaries still baked after the strip: $bleft"
test "$left" -eq 0 || exit 1
test "$bleft" -eq 0 || exit 1
OVCMD

# Layer: github.com/opencharly/layer-ssh-client
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
pacman-key --init && \
(pacman-key --populate 2>/dev/null || true) && \
pacman -Syu --noconfirm --needed openssh

# Layer: github.com/opencharly/layer-agent-forwarding

# Layer: github.com/opencharly/layer-cdi
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
RUN --mount=type=bind,from=cdi,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
# The directories are overridable so the assertion can be EXECUTED against fixtures
# (and so a bed can prove it discriminates) without a GPU or an image build. The
# default is the image's own layout.
# THREE surfaces, because the removal touches three: the top-level libraries, the
# driver TREES the packages ship (nvidia/, vdpau/ — where libvdpau_nvidia.so lives),
# and the xorg driver. An assertion that only counts the first surface passes on an
# image whose vdpau/xorg driver content survived, which is exactly what the deleted
# strip's `rm -rf` lines existed to remove.
libs=${CDI_LIB_DIRS:-/usr/lib /usr/lib64}
trees=${CDI_TREE_DIRS:-/usr/lib/nvidia /usr/lib64/nvidia /usr/lib/vdpau}
xorg=${CDI_XORG_DRIVER:-/usr/lib/xorg/modules/drivers/nvidia_drv.so}
left=0
for d in $libs; do
  [ -d "$d" ] || continue
  n=$(find "$d" -maxdepth 1 \( -type f -o -type l \) \
      \( -name 'libnvidia-*.so*' -o -name 'libcuda*.so*' -o -name 'libnvcuvid.so*' \
      -o -name 'libnvoptix.so*' -o -name 'libGLX_nvidia.so*' \
      -o -name 'libEGL_nvidia.so*' -o -name 'libGLESv1_CM_nvidia.so*' \
      -o -name 'libGLESv2_nvidia.so*' -o -name 'libvdpau_nvidia.so*' \) 2>/dev/null | wc -l)
  left=$((left + n))
done
for d in $trees; do
  [ -d "$d" ] || continue
  n=$(find "$d" \( -type f -o -type l \) 2>/dev/null | wc -l)
  left=$((left + n))
done
if [ -e "$xorg" ] || [ -L "$xorg" ]; then left=$((left + 1)); fi
echo "cdi: driver libraries still baked: $left"
test "$left" -eq 0
OVCMD
RUN --mount=type=bind,from=cdi,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
bins=${CDI_BIN_DIRS:-/usr/bin /usr/local/bin /usr/sbin}
left=0
for d in $bins; do
  [ -d "$d" ] || continue
  n=$(find "$d" -maxdepth 1 \( -type f -o -type l \) -name 'nvidia*' 2>/dev/null | wc -l)
  left=$((left + n))
done
echo "cdi: nvidia binaries still baked: $left"
test "$left" -eq 0
OVCMD

