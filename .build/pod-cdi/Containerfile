(pacman-key --populate 2>/dev/null || true) && \
pacman -Syu --noconfirm --needed direnv
RUN mkdir -p '/etc/profile.d' && cat > '/etc/profile.d/charly-direnv-bash.sh' <<'CHARLY_SHELL_BASH_69705bba'
# opencharly: guard — this drop-in is for bash only (every /etc/profile.d/*.sh is sourced by every POSIX login shell)
if [ -n "${BASH_VERSION:-}" ] && [ -z "${ZSH_VERSION:-}" ]; then
	eval "$(direnv hook bash)"
fi

CHARLY_SHELL_BASH_69705bba
RUN mkdir -p '/etc/profile.d' && cat > '/etc/profile.d/charly-direnv-zsh.sh' <<'CHARLY_SHELL_ZSH_31939a23'
