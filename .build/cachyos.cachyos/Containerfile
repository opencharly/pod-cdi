# .build/cachyos.cachyos/Containerfile (generated -- do not edit)

ARG BASE_IMAGE=docker.io/cachyos/cachyos-v3@sha256:f50fa29540b3de01845f908202c91e4cddc7d1cdaac1b25ad33332afba94184b

FROM scratch AS cachyos-os-skills
COPY .build/_candy/cachyos-os-skills/ /

FROM scratch AS cachyos-base-check
COPY .build/_candy/cachyos-base-check/ /

FROM ${BASE_IMAGE}

USER root

# Bootstrap
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
    pacman-key --init && (grep -q '^DisableSandboxNetwork' /etc/pacman.conf || sed -i '/^\[options\]/a DisableSandboxNetwork' /etc/pacman.conf) && mkdir -p /etc/pacman.d/hooks && : > /etc/pacman.d/hooks/nvidia-ctk-cdi.hook && pacman -Syu --noconfirm --needed curl ca-certificates && \
    { [ -L /usr/local ] && mkdir -p "$(readlink /usr/local)"; mkdir -p /usr/local/bin; } && \
    ARCH=$(uname -m) && \
    case "$ARCH" in x86_64) ARCH=amd64;; aarch64) ARCH=arm64;; esac && \
    TASK_URL="https://github.com/go-task/task/releases/latest/download/task_linux_${ARCH}.tar.gz" && \
    (curl -fsSL "$TASK_URL" || wget -qO- "$TASK_URL") | tar -xzf - -C /usr/local/bin task

RUN if ! getent passwd 1000 >/dev/null 2>&1; then \
      LOGIN_SHELL=/bin/sh; [ -x /bin/bash ] && LOGIN_SHELL=/bin/bash; \
      if command -v useradd >/dev/null 2>&1; then \
        (getent group 1000 >/dev/null 2>&1 || groupadd -g 1000 user) && \
        useradd -m -u 1000 -g 1000 -s "$LOGIN_SHELL" user; \
      else \
        (getent group 1000 >/dev/null 2>&1 || addgroup -g 1000 user) && \
        adduser -D -h /home/user -u 1000 -G user -s "$LOGIN_SHELL" user; \
      fi; \
    fi

WORKDIR /home/user

# Layer: cachyos-os-skills
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
RUN --mount=type=bind,from=cachyos-os-skills,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
true
OVCMD

# Layer: cachyos-base-check
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
pacman-key --init && \
(pacman-key --populate 2>/dev/null || true) && \
pacman -Syu --noconfirm --needed pacman

USER 1000
